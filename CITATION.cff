    given-names: Selin
    orcid: "https://orcid.org/0009-0002-2296-994X"
    affiliation: "Technical University of Munich (TUM), Germany; Tsunoda Laboratory, The University of Tokyo, Japan"
version: "0.1.0"
date-released: "2026-07-28"
repository-code: "https://github.com/Sisistern123/OncoTox"
license: MIT
keywords:
  - single-cell RNA-seq
  - drug response prediction
  - foundation models
  - scGPT
  - pharmacogenomics
  - CTRPv2
